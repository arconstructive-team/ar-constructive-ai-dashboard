# Local testing on the Firebase emulators: `pnpm emulators` in one terminal, `pnpm dev:emulator` in another.
# The demo- project id keeps every call local: the emulators never reach a real Firebase project.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_APP_ID=demo-app
VITE_FIREBASE_AUTH_DOMAIN=demo-arconstructive.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-arconstructive
VITE_FIREBASE_STORAGE_BUCKET=demo-arconstructive.appspot.com
VITE_ALLOWED_EMAILS=ahk.archteam@gmail.com,rdghoorchian@gmail.com,mohsen.naghipourfar@gmail.com
# The local API (api/, `pnpm start` with PORT=8081 and the emulator hosts): the chat assistant and
# the site report. Empty it to have the keyword commands (/check, /regenerate) answer in the browser.
# Like production, VITE_API_URL stays unset, so the permit check runs in the browser.
VITE_CHAT_API_URL=http://localhost:8081
VITE_API_URL=
